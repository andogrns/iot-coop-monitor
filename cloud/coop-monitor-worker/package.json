{
  "name": "coop-monitor-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "prepare:credentials": "node scripts/prepare-credentials.mjs",
    "types": "wrangler types",
    "db:create": "wrangler d1 create coop-monitor-db --location apac",
    "db:migrate:local": "wrangler d1 migrations apply coop-monitor-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply coop-monitor-db --remote"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  }
}
